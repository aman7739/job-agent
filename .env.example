# Supabase Postgres Connection (use connection pooler URL for IPv4 compatibility)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Telegram Delivery
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# SMTP Email Delivery (Mailbox B)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_notification_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
NOTIFICATION_EMAIL=your_notification_email@gmail.com

# IMAP Email Alerts (Mailbox A)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_alerts_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password

# External APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
